# ---- required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Random secret, at least 16 chars (e.g. `openssl rand -hex 24`). Goes in the Home Assistant iframe URL and REST sensor.
CA_ACCESS_TOKEN=
# Optional second token that only opens the dashboard tile (see ha/phone-card.yaml). Put THIS one in the tile URL,
# not CA_ACCESS_TOKEN: it can show and pick the suggestions, and nothing else (no photos, wardrobe, settings, costs).
# Generate with `openssl rand -hex 24`; must differ from CA_ACCESS_TOKEN.
CA_TILE_TOKEN=
# Optional read-only token for the tv and the Home Assistant sensor (`?v=...` in the tile URL, or as the sensor's Bearer
# token): it can only look at the suggestions; the server refuses every change. All three tokens must be different.
CA_VIEW_TOKEN=
# Public https URL of this app behind Nginx Proxy Manager (used for the image links shown on the TV and phone).
PUBLIC_BASE_URL=https://ca.example.nl

# ---- docker / host --------------------------------------------------------
PUID=1000
PGID=1000
BIND_ADDRESS=0.0.0.0
PORT=8080
TZ=Europe/Amsterdam

# ---- models (Sonnet 5: good vision + reasoning at a moderate price) ----------
CATALOG_MODEL=claude-sonnet-5
STYLIST_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max -- how hard the stylist thinks (higher = better combinations, more cost)
STYLIST_EFFORT=high
OUTFIT_COUNT=3
REPEAT_DAYS=7

# ---- budget & alerts ----------------------------------------------------------
MONTHLY_BUDGET_EUR=10
# enforce = stop Claude calls at 100% of the budget; warn = only notify
BUDGET_MODE=enforce
BUDGET_ALERT_PCTS=80,100
USD_EUR_RATE=0.92

# ---- Home Assistant (weather + push alerts) --------------------------------------
HA_URL=http://10.0.0.10:8123
# Long-lived access token: HA profile -> Security -> Long-lived access tokens
HA_TOKEN=
# Can also be set later in the app under Settings.
HA_WEATHER_ENTITY=
# e.g. notify.mobile_app_pixel_8  (Developer tools -> Actions, search "notify.")
HA_NOTIFY_SERVICE=
# Origin of your HA instance, lets the app be shown inside the HA iframe card.
HA_ORIGIN=https://ha.example.nl

# ---- optional e-mail alerts (in addition to the HA push) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
# Docker Compose reads $ in .env as a variable: write every literal $ in a password as $$
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- optional single sign-on through Authentik (identity-platform repo) ----------------------------------------
# Leave OIDC_ISSUER empty to keep using only the tokens above. With it set, /app/login gets a "Sign in" button and the
# tokens stay as emergency access (and the tile/view tokens are not affected at all).
# Issuer = the address people see in their browser: https://<authentik host>/application/o/clothing-advisor/
OIDC_ISSUER=
OIDC_CLIENT_ID=clothing-advisor
# The same value as CLOTHING_ADVISOR_OIDC_SECRET in the identity-platform .env (openssl rand -hex 32).
OIDC_CLIENT_SECRET=
# Every address this app is opened on, ending in /app/oidc/callback (space separated); all must be in the Authentik blueprint.
OIDC_REDIRECT_URIS=
# How this container reaches Authentik on the shared docker network (the public name is often not resolvable from here).
OIDC_INTERNAL_URL=http://authentik:9000
# Authentik groups -> access: admin = the whole app, viewer = read-only (like the tv token).
OIDC_ADMIN_GROUP=clothing-advisor-admin
OIDC_VIEWER_GROUP=clothing-advisor-viewer
# Days a browser stays signed in here before it asks Authentik again (1-90). Removing someone in Authentik takes effect
# at the latest after this. Changing CA_ACCESS_TOKEN signs everybody out immediately.
OIDC_SESSION_DAYS=7
